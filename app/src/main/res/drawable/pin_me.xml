<?xml version="1.0" encoding="utf-8"?>
<!--
  The courier: a chevron with the cone of where they are facing, the shape a
  person already reads as "me, going that way" from every navigation app. It
  is deliberately not a disc or a teardrop — the pickup and the customer are
  teardrops, and when the courier arrives on top of one the two must still
  read as two things.

  Drawn facing north; the map turns it by the courier's heading. The anchor
  sits on the chevron, not on the image centre, so the cone projects ahead of
  the courier's actual position instead of dragging it forward.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="46dp" android:height="46dp" android:viewportWidth="48" android:viewportHeight="48">
    <path android:fillColor="#2F7D4F" android:fillAlpha="0.22" android:pathData="M24,31 L10.5,8.5 Q24,1.5 37.5,8.5 Z"/>
    <path android:fillColor="#2F7D4F" android:fillAlpha="0.34" android:pathData="M24,31 L16,13 Q24,10 32,13 Z"/>
    <path android:fillColor="#2F7D4F" android:strokeColor="#FFFFFF" android:strokeWidth="2.6"
        android:strokeLineJoin="round" android:pathData="M24,21.5 L33.5,41 L24,35.6 L14.5,41 Z"/>
</vector>
