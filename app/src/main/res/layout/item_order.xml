<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/card" android:padding="12dp" android:layout_marginTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/orderId" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" android:fontFamily="monospace"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
    </LinearLayout>
    <TextView android:id="@+id/orderMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted"/>
    <TextView android:id="@+id/orderItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/pickup" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ink" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/deliverTo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ink"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/route" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Route"/>
        <Button android:id="@+id/action" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:backgroundTint="@color/accent" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
